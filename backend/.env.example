# "memory" starts an in-process MongoDB (mongodb-memory-server) - zero setup.
# For a real database: mongodb://localhost:27017/edvexa_dispatch
MONGO_URI=memory

# "memory" uses ioredis-mock (single process only). For real Redis: redis://localhost:6379
REDIS_URL=memory

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Must be >= 16 chars. Always override in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Agent is marked offline if no heartbeat arrives within this window
HEARTBEAT_TTL_MS=20000
# How often the background sweeper runs (offer timeouts, presence, pending queue)
SWEEP_INTERVAL_MS=2000
# Redis lock TTL for per-request critical sections
LOCK_TTL_MS=10000

# Seed demo users/agents when the database is empty
SEED_ON_START=true
